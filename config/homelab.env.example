# homelab.env - YOUR site values. Copy to config/homelab.env (git-ignored) and edit.
#
# Two consumers:
#   1. tools/localize.py rewrites the fictional reference values throughout the repo
#      (Wazuh rules, Zeek config, hunting scripts, agent config, map) to these values.
#      Run it after every edit:  python3 tools/localize.py --apply
#   2. Workstation helper scripts source this file at run time (runfw-via-pve.sh,
#      run-on-ct.sh, sync-rules.sh, publish-local.sh, MCP installers).
#
# Settings that live on the HOSTS (watchdog, span mirror, backup) are separate
# /etc/default files - see docs/configure.md. No secrets belong in this file.

# ---- Segments: one /24 each. VLAN = 802.1Q tag on the trunk. ----------------
TRUSTED_NET=10.10.110.0/24
TRUSTED_VLAN=110
IOT_NET=10.10.120.0/24
IOT_VLAN=120
MGMT_NET=10.10.130.0/24
MGMT_VLAN=130
LAB_NET=10.10.140.0/24
LAB_VLAN=140
DIRECT_NET=10.10.150.0/24
DIRECT_VLAN=150
# A supernet covering every internal segment above (used by the Wazuh
# "internal -> internal blocked flow" rule). Must contain all five /24s.
INTERNAL_SUPERNET=10.10.0.0/16

# ---- Host addresses -----------------------------------------------------------
PVE_HOST=10.10.130.10        # Proxmox host, on MGMT
FW_MGMT_IP=10.10.130.1       # OPNsense address on MGMT (gateway .1 of each segment)
WAZUH_IP=10.10.140.11
SCANNER_IP=10.10.140.12      # Greenbone - authorized scanner, demoted in Wazuh
NETALERTX_IP=10.10.140.13
GUAC_IP=10.10.140.20
ZEEK_IP=10.10.140.21
PENTEST_IP=10.10.140.24      # Kali - second authorized scanner, demoted in Wazuh

# ---- Proxmox guest IDs --------------------------------------------------------
FW_VMID=200                  # OPNsense VM
WAZUH_CTID=201
GREENBONE_CTID=202
NETALERTX_CTID=203
KALI_VMID=204
GUAC_CTID=205
ZEEK_CTID=206

# ---- Interfaces -----------------------------------------------------------------
FW_TRUNK_NETIF=1             # firewall VM NIC index on the LAN trunk (net1 -> tap<FW_VMID>i1)
ZEEK_CAPTURE_NETIF=1         # Zeek CT NIC index used for capture (net1 -> eth1 / veth<ZEEK_CTID>i1)

# ---- Access / services ----------------------------------------------------------
PVE_SSH=root@10.10.130.10    # how the workstation reaches the Proxmox host
MAP_BIND=10.10.130.10        # map web server bind address (MGMT only)
MAP_PORT=8088
OP_VAULT=Homelab             # 1Password vault holding the items in docs/configure.md
