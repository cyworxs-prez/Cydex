# Copy to config/homelab.env and edit. Sourced by the workstation-side helper
# scripts (runfw-via-pve.sh, run-on-ct.sh, sync-rules.sh, publish-local.sh).
# config/homelab.env is git-ignored. No secrets belong in this file.

# Proxmox host (MGMT VLAN)
PVE_HOST=10.10.130.10
PVE_SSH=root@10.10.130.10

# Guest IDs
FW_VMID=200        # OPNsense VM
WAZUH_CTID=201     # Wazuh all-in-one LXC
ZEEK_CTID=206      # Zeek sensor LXC

# Addresses
FW_MGMT_IP=10.10.130.1
WAZUH_IP=10.10.140.11
SCANNER_IP=10.10.140.12   # Greenbone - authorized scanner, demoted in Wazuh

# Network map server (served from pve, MGMT only)
MAP_BIND=10.10.130.10
MAP_PORT=8088
