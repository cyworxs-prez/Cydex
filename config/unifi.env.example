# Copy to config/unifi.env (git-ignored). OPTIONAL - only for UniFi switches/APs/gateways.
# Used by ai-ops/mcp/unifi/run-unifi-mcp.sh. Values may be literals or 1Password references.
#
# UNIFI_LOCAL_HOST is the address of whatever runs the UniFi Network application:
#   - a UniFi gateway/console: its management address
#   - switches/APs only: the host running UniFi OS Server / the Network app
UNIFI_API_TYPE=local
UNIFI_LOCAL_HOST=10.10.130.2
UNIFI_LOCAL_PORT=443
UNIFI_LOCAL_VERIFY_SSL=false
UNIFI_DEFAULT_SITE=default
UNIFI_API_KEY="op://Homelab/unifi-api/credential"
# Keep the server's audit log of mutating calls.
UNIFI_AUDIT_LOG_ENABLED=true
