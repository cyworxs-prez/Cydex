# Copy to .env (chmod 600) in /opt/guac on the Guacamole CT. Never commit .env.
#
# Database password - generate one, do not reuse:  openssl rand -base64 24
# Only the two containers use it; nothing outside the CT ever needs it.
POSTGRES_PASSWORD=

# Second factor for every Guacamole login. Leave on: this box holds saved credentials
# for everything it can reach.
TOTP_ENABLED=true

# Ban after N failed logins from one address, for N seconds.
BAN_MAX_INVALID_ATTEMPTS=5
BAN_ADDRESS_DURATION=300
