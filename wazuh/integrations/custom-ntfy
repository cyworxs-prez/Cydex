#!/usr/bin/env python3
"""
Wazuh -> ntfy integration.
Invoked by wazuh-integratord as:  custom-ntfy <alert_file> <api_key> <hook_url>
Read-only with respect to the lab: it only reads the alert file and POSTs out.
"""
import json
import sys
import urllib.request
import urllib.error

LOG = "/var/ossec/logs/integrations.log"


def log(msg):
    try:
        with open(LOG, "a") as fh:
            fh.write("custom-ntfy: %s\n" % msg)
    except Exception:
        pass


def main():
    if len(sys.argv) < 4:
        log("missing args")
        return 1
    alert_file, hook_url = sys.argv[1], sys.argv[3]

    try:
        with open(alert_file) as fh:
            alert = json.load(fh)
    except Exception as exc:
        log("could not parse alert: %s" % exc)
        return 1

    rule = alert.get("rule", {}) or {}
    agent = alert.get("agent", {}) or {}
    level = int(rule.get("level", 0) or 0)
    desc = rule.get("description", "Wazuh alert")

    # ntfy priority: 5=max, 4=high. Level 12+ is "attack in progress" territory.
    priority = "urgent" if level >= 12 else "high"
    tags = "rotating_light" if level >= 12 else "warning"

    detail = alert.get("full_log") or json.dumps(alert.get("data", {}))[:600]
    body = "Agent: %s (%s)\nRule:  %s  level %s\nTime:  %s\n\n%s" % (
        agent.get("name", "unknown"),
        agent.get("ip", "-"),
        rule.get("id", "?"),
        level,
        alert.get("timestamp", ""),
        (detail or "")[:700],
    )

    req = urllib.request.Request(
        hook_url,
        data=body.encode("utf-8"),
        headers={
            "Title": ("[L%s] %s" % (level, desc))[:180],
            "Priority": priority,
            "Tags": tags,
        },
    )
    try:
        urllib.request.urlopen(req, timeout=10)
        log("sent level %s rule %s" % (level, rule.get("id")))
    except urllib.error.URLError as exc:
        log("send failed: %s" % exc)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
