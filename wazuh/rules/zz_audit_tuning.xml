<!--
  Cross-file tuning. Must sort last: Wazuh loads rule files alphabetically and ignores a child whose parent is defined in a later file.
-->
<group name="audit_tuning,">

  <rule id="100718" level="0">
    <if_sid>100715</if_sid>
    <match type="pcre2">"id\.resp_h":"(192\.168\.|10\.|172\.(1[6-9]|2[0-9]|3[01])\.)</match>
    <description>Zeek TLS: self-signed certificate on an internal destination (expected)</description>
    <group>zeek,ssl,expected_noise,</group>
  </rule>

  <rule id="100719" level="0">
    <if_sid>100715</if_sid>
    <field name="version">^DTLS</field>
    <description>Zeek TLS: self-signed DTLS certificate (WebRTC, expected)</description>
    <group>zeek,ssl,expected_noise,</group>
  </rule>

  <rule id="100728" level="0">
    <if_sid>40112</if_sid>
    <srcip>10.10.140.12</srcip>
    <description>Authorised scanner (Greenbone): auth failures then success - suppressed</description>
    <group>scanner_allowlist,expected_noise,</group>
  </rule>

  <rule id="100729" level="0">
    <if_sid>40112</if_sid>
    <srcip>10.10.140.24</srcip>
    <description>Authorised scanner (Kali lab host): auth failures then success - suppressed</description>
    <group>scanner_allowlist,expected_noise,</group>
  </rule>

  <rule id="100825" level="0">
    <program_name>^yara-freshness$</program_name>
    <description>YARA freshness checker message</description>
    <group>yara,collector_health,</group>
  </rule>

  <rule id="100826" level="10">
    <if_sid>100825</if_sid>
    <match>STALE</match>
    <description>YARA scanning has stopped reporting on one or more hosts - endpoint scanning coverage is not current</description>
    <mitre><id>T1562.001</id></mitre>
    <group>yara,collector_health,scanner_stale,</group>
  </rule>

  <rule id="100827" level="3">
    <if_sid>100825</if_sid>
    <match>FRESH</match>
    <description>YARA scan freshness verified on all hosts</description>
    <group>yara,collector_health,</group>
  </rule>

  <rule id="100930" level="0">
    <decoded_as>json</decoded_as>
    <field name="log" type="pcre2">EventLoggingListener|InMemoryAuthenticationFailureTracker</field>
    <description>Guacamole authentication event (base)</description>
    <group>guacamole,authentication,</group>
  </rule>

  <rule id="100931" level="5">
    <if_sid>100930</if_sid>
    <field name="log" type="pcre2">Authentication attempt .*failed</field>
    <description>Guacamole: failed login attempt on the lab console gateway</description>
    <mitre><id>T1110</id></mitre>
    <group>guacamole,authentication,authentication_failed,</group>
  </rule>

  <rule id="100932" level="10" frequency="3" timeframe="300">
    <if_matched_sid>100931</if_matched_sid>
    <description>Guacamole: repeated failed logins - possible brute force against the console gateway</description>
    <mitre><id>T1110</id></mitre>
    <group>guacamole,authentication,brute_force,</group>
  </rule>

  <rule id="100934" level="10">
    <if_sid>100930</if_sid>
    <field name="log" type="pcre2">Blocking authentication attempt from address</field>
    <description>Guacamole is BLOCKING logins - its brute-force tracker has tripped on the console gateway</description>
    <mitre><id>T1110</id></mitre>
    <group>guacamole,authentication,brute_force,</group>
  </rule>

  <rule id="100933" level="5">
    <if_sid>100930</if_sid>
    <field name="log" type="pcre2">successfully authenticated</field>
    <description>Guacamole: successful login to the lab console gateway</description>
    <mitre><id>T1078</id></mitre>
    <group>guacamole,authentication,authentication_success,</group>
  </rule>

  <rule id="100735" level="12" frequency="2" timeframe="2400">
    <if_matched_sid>100731</if_matched_sid>
    <description>SENSOR BLIND: Zeek has reported zero acks repeatedly - the sensor is seeing no traffic</description>
    <mitre><id>T1562.001</id></mitre>
    <group>zeek,collector_health,sensor_blind,</group>
  </rule>

  <rule id="100915" level="5">
    <if_sid>100906</if_sid>
    <match>FETCH FAILED</match>
    <description>Zeek Intel: one threat feed failed to download - indicator set still rebuilt from the others</description>
    <group>zeek,collector_health,</group>
  </rule>

</group>
