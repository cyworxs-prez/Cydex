<!--
  SPAN mirror health (logger tag from the span hookscript). A fully blind Zeek reports 0% capture loss, so this checks the mirror directly. Applied 3; not applied 12.
-->
<group name="zeek,ids,collector_health,local,">

  <rule id="100890" level="0">
    <program_name>^vm200-span$</program_name>
    <description>Zeek span hookscript message (parent)</description>
  </rule>

  <rule id="100891" level="3">
    <if_sid>100890</if_sid>
    <match>span re-applied</match>
    <description>Zeek span mirror re-applied after OPNsense start - sensor feed restored</description>
  </rule>

  <rule id="100892" level="12">
    <if_sid>100890</if_sid>
    <match>NOT applied|span WRONG</match>
    <description>SENSOR BLIND: Zeek span mirror could not be applied - Zeek is receiving NO traffic</description>
    <mitre><id>T1562.001</id></mitre>
    <group>sensor_blind,</group>
  </rule>

</group>
