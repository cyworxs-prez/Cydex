<!--
  Zeek Intel framework matches by source confidence (local 14, botnet C2 12, URL 10, malware domain 8, Tor exit 5) and feed-updater health.
-->
<group name="zeek,zeek_intel,">

  <rule id="100900" level="0">
    <decoded_as>json</decoded_as>
    <field name="seen.indicator">\.+</field>
    <field name="sources">\.+</field>
    <description>Zeek Intel framework match (base)</description>
    <group>zeek,ioc_match,</group>
  </rule>

  <rule id="100901" level="10">
    <if_sid>100900</if_sid>
    <description>Zeek Intel: IOC match $(seen.indicator) at $(seen.where) [$(sources)]</description>
    <mitre><id>T1071</id></mitre>
    <group>zeek,ioc_match,</group>
  </rule>

  <rule id="100902" level="14">
    <if_sid>100901</if_sid>
    <field name="sources">local</field>
    <description>Zeek Intel: LOCAL indicator $(seen.indicator) matched at $(seen.where)</description>
    <mitre><id>T1071</id></mitre>
    <group>zeek,ioc_match,local_ioc,</group>
  </rule>

  <rule id="100903" level="12">
    <if_sid>100901</if_sid>
    <field name="sources">feodo|threatfox</field>
    <description>Zeek Intel: botnet C2 indicator $(seen.indicator) matched at $(seen.where)</description>
    <mitre><id>T1071</id><id>T1571</id></mitre>
    <group>zeek,ioc_match,c2,</group>
  </rule>

  <rule id="100904" level="5">
    <if_sid>100901</if_sid>
    <field name="sources">tor-exit</field>
    <description>Zeek Intel: Tor exit node $(seen.indicator) seen at $(seen.where)</description>
    <mitre><id>T1090.003</id></mitre>
    <group>zeek,ioc_match,tor,</group>
  </rule>

  <rule id="100905" level="8">
    <if_sid>100901</if_sid>
    <field name="sources">urlhaus-domain</field>
    <description>Zeek Intel: URLhaus malware host $(seen.indicator) resolved at $(seen.where)</description>
    <mitre><id>T1071.001</id></mitre>
    <group>zeek,ioc_match,malware_host,</group>
  </rule>

  <rule id="100906" level="0">
    <program_name>^zeek-intel$</program_name>
    <description>zeek-intel updater message</description>
    <group>zeek,collector_health,</group>
  </rule>

  <rule id="100907" level="10">
    <if_sid>100906</if_sid>
    <match>REFRESH ABORTED</match>
    <description>Zeek Intel refresh ABORTED - the indicator set did not update at all</description>
    <mitre><id>T1562.001</id></mitre>
    <group>zeek,collector_health,intel_stale,</group>
  </rule>

  <rule id="100909" level="12">
    <if_sid>100906</if_sid>
    <match>RESTART FAILED</match>
    <description>SENSOR MAY BE DOWN: Zeek restart after an Intel refresh failed</description>
    <mitre><id>T1562.001</id></mitre>
    <group>zeek,collector_health,sensor_blind,</group>
  </rule>

  <rule id="100908" level="3">
    <if_sid>100906</if_sid>
    <match>REFRESH OK</match>
    <description>Zeek Intel feeds refreshed</description>
    <group>zeek,collector_health,</group>
  </rule>

</group>
